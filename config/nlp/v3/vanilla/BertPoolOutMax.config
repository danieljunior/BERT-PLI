[train] #train parameters
epoch = 1
batch_size = 32

reader_num = 1

optimizer = bert_adam
learning_rate = 1e-5
weight_decay = 0
step_size = 1
lr_multiplier = 1

[eval] #eval parameters
batch_size = 32

reader_num = 1

[data] #data parameters
train_dataset_type = JsonFromFiles
train_formatter_type = BertDocPara
train_data_path = ./data/COLIEE
train_file_list = train_vanilla_sentences.json

valid_dataset_type = JsonFromFiles
valid_formatter_type = BertDocPara
valid_data_path = ./data/COLIEE
valid_file_list = train_vanilla_sentences.json

test_dataset_type = JsonFromFiles
test_formatter_type = BertDocPara
test_data_path = ./data/COLIEE
test_file_list = train_vanilla_sentences.json

recursive = False
json_format = line

max_seq_length = 512

[model] #model parameters
model_name = BertPoolOutMax
max_para_c = 80
max_para_q = 108
step=9

bert_path = bert-base-uncased

output_dim = 2
output_mode = classification

[output] #output parameters
output_time = 1
test_time = 1
save_step = 100

model_path = output/results/vanilla
model_name = v3_train_poolout_max.json

tensorboard_path = output/tensorboard

accuracy_method = SingleLabelTop1
output_function = Basic
output_value = micro_precision,macro_precision,macro_recall,macro_f1

tqdm_ncols = 150
